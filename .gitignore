# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.dll
*.dylib

# C++ Build outputs & binaries
build/
dist/
*.egg-info/
*.lib
*.exp
*.obj
*.o
.cmake/
CMakeCache.txt
CMakeFiles/

# Virtual Environments
venv/
env/
game_env/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local skills/docs
SKILLS.md
.agents/

# Agent scratch state. .claude/worktrees/ holds checkouts of this same repo, so
# without this a `git add -A` commits a second copy of the whole source tree —
# the duplicate-package shadowing that pytest.ini's `pythonpath = src` exists to
# prevent, except versioned.
.claude/

# OpenCV temporary/large files
*.onnx
*.pb
*.tflite
# MediaPipe Tasks model bundles. Fetched on demand — examples/pose_attribution.py
# pulls pose_landmarker_lite.task (~5.5 MB) with --download.
*.task
assets/
*.xml
*.yml
*.yaml
*.mp4
*.avi
*.h264
*.mkv
captures/
logs/

# Test-bench output (regenerate with benchmarks/run_all.py --html)
benchmarks/bench_report.html
benchmarks/*.json


# Device logs from a real play session (visual_ai/devicelog.py). Machine-local
# diagnostics, never committed.
data/device-logs/
